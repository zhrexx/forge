BUILD_FOLDER = "build"

target {
    name = "init",
    build = function()
        mkdir(BUILD_FOLDER)
    end
}

target {
    name = "build",
    depends = {"init", "link"},
    build = function()
        print("Building...")
    end,
    exec = function()
        print("Started building...")
    end,
    after_exec = function()
        print("Finished build target.")
    end
}

target {
    name = "link",
    inputs = {BUILD_FOLDER .. "/forge.o"},
    outputs = {BUILD_FOLDER .. "/forge"},
    depends = {"compile"},
    build = function()
        exec("g++ " .. BUILD_FOLDER .. "/forge.o -o " .. BUILD_FOLDER .. "/forge -llua")
    end,
}

target {
    name = "compile",
    inputs = {"forge.cpp"},
    outputs = {BUILD_FOLDER .. "/forge.o"},
    build = function()
        exec("g++ -c forge.cpp -o " .. BUILD_FOLDER .. "/forge.o")
    end,
}
